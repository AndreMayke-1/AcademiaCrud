@model IEnumerable<AcademiaCrud.Models.Instrutor>

@{
    ViewData["Title"] = "Index";
}

<h1>Instrutores</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Criar um Novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.telefone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sexo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idade)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.telefone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.sexo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idade)
            </td>
            <td>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.idInstrutor">Editar</a> 
                    <a class="btn btn-success" asp-action="Details" asp-route-id="@item.idInstrutor">Visualizar</a> 
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.idInstrutor">Excluir</a>
                    
            </td>
        </tr>
}
    </tbody>
</table>
