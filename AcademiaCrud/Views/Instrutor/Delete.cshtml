@model AcademiaCrud.Models.Instrutor

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Instrutor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
